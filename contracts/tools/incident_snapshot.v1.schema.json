{
  "$defs": {
    "AttributionItem": {
      "additionalProperties": false,
      "description": "Verified contribution of one slice to excess failures.",
      "properties": {
        "baseline_attempts": {
          "exclusiveMinimum": 0,
          "title": "Baseline Attempts",
          "type": "integer"
        },
        "baseline_failures": {
          "minimum": 0,
          "title": "Baseline Failures",
          "type": "integer"
        },
        "confidence_ppm": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Confidence Ppm",
          "type": "integer"
        },
        "contribution_ppm": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Contribution Ppm",
          "type": "integer"
        },
        "current_attempts": {
          "exclusiveMinimum": 0,
          "title": "Current Attempts",
          "type": "integer"
        },
        "current_failures": {
          "minimum": 0,
          "title": "Current Failures",
          "type": "integer"
        },
        "dimension": {
          "$ref": "#/$defs/CohortDimension"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "evidence_kind": {
          "const": "verified_observation",
          "default": "verified_observation",
          "title": "Evidence Kind",
          "type": "string"
        },
        "excess_failures_milli": {
          "minimum": 0,
          "title": "Excess Failures Milli",
          "type": "integer"
        },
        "expected_failures_milli": {
          "minimum": 0,
          "title": "Expected Failures Milli",
          "type": "integer"
        },
        "rank": {
          "exclusiveMinimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "value": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "value",
        "rank",
        "current_attempts",
        "current_failures",
        "baseline_attempts",
        "baseline_failures",
        "expected_failures_milli",
        "excess_failures_milli",
        "contribution_ppm",
        "confidence_ppm",
        "evidence_event_ids"
      ],
      "title": "AttributionItem",
      "type": "object"
    },
    "CohortDimension": {
      "description": "Allowlisted dimensions that can define a detector cohort.",
      "enum": [
        "method",
        "issuer",
        "error_source",
        "error_step",
        "error_reason"
      ],
      "title": "CohortDimension",
      "type": "string"
    },
    "CohortPredicate": {
      "additionalProperties": false,
      "description": "One exact, reviewable cohort condition.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/CohortDimension"
        },
        "value": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "title": "CohortPredicate",
      "type": "object"
    },
    "IncidentEvidence": {
      "additionalProperties": false,
      "description": "Counts and confidence required to justify a degradation incident.",
      "properties": {
        "baseline_attempts": {
          "exclusiveMinimum": 0,
          "title": "Baseline Attempts",
          "type": "integer"
        },
        "baseline_successes": {
          "minimum": 0,
          "title": "Baseline Successes",
          "type": "integer"
        },
        "confidence_ppm": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Confidence Ppm",
          "type": "integer"
        },
        "current_attempts": {
          "exclusiveMinimum": 0,
          "title": "Current Attempts",
          "type": "integer"
        },
        "current_successes": {
          "minimum": 0,
          "title": "Current Successes",
          "type": "integer"
        },
        "excess_failures": {
          "minimum": 0,
          "title": "Excess Failures",
          "type": "integer"
        },
        "minimum_attempts": {
          "exclusiveMinimum": 0,
          "title": "Minimum Attempts",
          "type": "integer"
        },
        "observed_success_rate_drop_bps": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Observed Success Rate Drop Bps",
          "type": "integer"
        }
      },
      "required": [
        "baseline_attempts",
        "baseline_successes",
        "current_attempts",
        "current_successes",
        "minimum_attempts",
        "observed_success_rate_drop_bps",
        "confidence_ppm",
        "excess_failures"
      ],
      "title": "IncidentEvidence",
      "type": "object"
    },
    "IncidentStatus": {
      "description": "States exposed by the incident contract in P0.",
      "enum": [
        "open",
        "resolved"
      ],
      "title": "IncidentStatus",
      "type": "string"
    }
  },
  "$id": "https://retryrail.dev/contracts/tools/incident-snapshot/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "PII-free allowlist sent to an incident-analysis provider.\n\nThis contract deliberately excludes merchant identifiers, raw events, payment\nidentifiers, descriptions, notes, customer fields, secrets and action authority.",
  "properties": {
    "action_eligible": {
      "title": "Action Eligible",
      "type": "boolean"
    },
    "affected_cohort": {
      "items": {
        "$ref": "#/$defs/CohortPredicate"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Affected Cohort",
      "type": "array"
    },
    "currency": {
      "maxLength": 3,
      "minLength": 3,
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "detector_hypotheses": {
      "items": {
        "maxLength": 400,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Detector Hypotheses",
      "type": "array"
    },
    "detector_version": {
      "maxLength": 80,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Detector Version",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/IncidentEvidence"
    },
    "gmv_at_risk_subunits": {
      "minimum": 0,
      "title": "Gmv At Risk Subunits",
      "type": "integer"
    },
    "incident_id": {
      "maxLength": 80,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Incident Id",
      "type": "string"
    },
    "last_observed_at": {
      "format": "date-time",
      "title": "Last Observed At",
      "type": "string"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "single_merchant",
      "default": "single_merchant",
      "title": "Scope",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 80,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "unknowns": {
      "items": {
        "maxLength": 400,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Unknowns",
      "type": "array"
    },
    "verified_attributions": {
      "items": {
        "$ref": "#/$defs/AttributionItem"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Verified Attributions",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "incident_id",
    "detector_version",
    "status",
    "opened_at",
    "last_observed_at",
    "affected_cohort",
    "evidence",
    "verified_attributions",
    "detector_hypotheses",
    "unknowns",
    "gmv_at_risk_subunits",
    "currency",
    "action_eligible",
    "synthetic"
  ],
  "title": "RetryRail Redacted Incident Snapshot v1",
  "type": "object"
}

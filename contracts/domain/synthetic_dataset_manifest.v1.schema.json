{
  "$defs": {
    "ArtifactDigest": {
      "additionalProperties": false,
      "description": "Stable identity and record count for one generated artifact.",
      "properties": {
        "bytes": {
          "exclusiveMinimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_./-]+$",
          "title": "Path",
          "type": "string"
        },
        "records": {
          "exclusiveMinimum": 0,
          "title": "Records",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "records"
      ],
      "title": "ArtifactDigest",
      "type": "object"
    },
    "CohortDimension": {
      "description": "Allowlisted dimensions that can define a detector cohort.",
      "enum": [
        "method",
        "issuer",
        "error_source",
        "error_step",
        "error_reason"
      ],
      "title": "CohortDimension",
      "type": "string"
    },
    "CohortPredicate": {
      "additionalProperties": false,
      "description": "One exact, reviewable cohort condition.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/CohortDimension"
        },
        "value": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "title": "CohortPredicate",
      "type": "object"
    },
    "DatasetPartition": {
      "additionalProperties": false,
      "description": "Physical split boundary and its exact volume.",
      "properties": {
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "event_artifact": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_./-]+$",
          "title": "Event Artifact",
          "type": "string"
        },
        "normalized_events": {
          "exclusiveMinimum": 0,
          "title": "Normalized Events",
          "type": "integer"
        },
        "payment_attempts": {
          "exclusiveMinimum": 0,
          "title": "Payment Attempts",
          "type": "integer"
        },
        "split": {
          "$ref": "#/$defs/DatasetSplit"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "truth_artifact": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_./-]+$",
          "title": "Truth Artifact",
          "type": "string"
        }
      },
      "required": [
        "split",
        "starts_at",
        "ends_at",
        "payment_attempts",
        "normalized_events",
        "event_artifact",
        "truth_artifact"
      ],
      "title": "DatasetPartition",
      "type": "object"
    },
    "DatasetSplit": {
      "description": "Leakage boundary between detector development and final evaluation.",
      "enum": [
        "tuning",
        "heldout"
      ],
      "title": "DatasetSplit",
      "type": "string"
    },
    "DeliveryCaseSummary": {
      "additionalProperties": false,
      "description": "Reviewable count of every required reliability anomaly.",
      "properties": {
        "delivery_attempts": {
          "exclusiveMinimum": 0,
          "title": "Delivery Attempts",
          "type": "integer"
        },
        "expected_duplicates": {
          "minimum": 0,
          "title": "Expected Duplicates",
          "type": "integer"
        },
        "expected_rejections": {
          "minimum": 0,
          "title": "Expected Rejections",
          "type": "integer"
        },
        "reliability_case": {
          "$ref": "#/$defs/ReliabilityCase"
        }
      },
      "required": [
        "reliability_case",
        "delivery_attempts",
        "expected_rejections",
        "expected_duplicates"
      ],
      "title": "DeliveryCaseSummary",
      "type": "object"
    },
    "ErrorEvidence": {
      "additionalProperties": false,
      "description": "Allowlisted failure evidence; descriptions and customer data are excluded.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "step": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        }
      },
      "title": "ErrorEvidence",
      "type": "object"
    },
    "ExperimentDesign": {
      "additionalProperties": false,
      "description": "Pre-results assignment and outcome rules frozen for later M5 use.",
      "properties": {
        "assignment_hash": {
          "const": "sha256",
          "default": "sha256",
          "title": "Assignment Hash",
          "type": "string"
        },
        "assignment_namespace": {
          "maxLength": 80,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Assignment Namespace",
          "type": "string"
        },
        "assignment_unit": {
          "const": "payment_id",
          "default": "payment_id",
          "title": "Assignment Unit",
          "type": "string"
        },
        "attribution_window_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 604800,
          "title": "Attribution Window Seconds",
          "type": "integer"
        },
        "control_allocation_bps": {
          "exclusiveMaximum": 10000,
          "exclusiveMinimum": 0,
          "title": "Control Allocation Bps",
          "type": "integer"
        },
        "control_recovery_rate_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Control Recovery Rate Bps",
          "type": "integer"
        },
        "design_id": {
          "maxLength": 80,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Design Id",
          "type": "string"
        },
        "eligibility_frozen_before_assignment": {
          "const": true,
          "default": true,
          "title": "Eligibility Frozen Before Assignment",
          "type": "boolean"
        },
        "exclude_already_recovered": {
          "const": true,
          "default": true,
          "title": "Exclude Already Recovered",
          "type": "boolean"
        },
        "failed_payments_only": {
          "const": true,
          "default": true,
          "title": "Failed Payments Only",
          "type": "boolean"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "incident_members_only": {
          "const": true,
          "default": true,
          "title": "Incident Members Only",
          "type": "boolean"
        },
        "inconclusive_when_interval_crosses_zero": {
          "const": true,
          "default": true,
          "title": "Inconclusive When Interval Crosses Zero",
          "type": "boolean"
        },
        "outcome_namespace": {
          "maxLength": 80,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Outcome Namespace",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "strata": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Strata",
          "type": "array"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "treatment_allocation_bps": {
          "exclusiveMaximum": 10000,
          "exclusiveMinimum": 0,
          "title": "Treatment Allocation Bps",
          "type": "integer"
        },
        "treatment_recovery_rate_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Treatment Recovery Rate Bps",
          "type": "integer"
        }
      },
      "required": [
        "design_id",
        "frozen_at",
        "assignment_namespace",
        "outcome_namespace",
        "treatment_allocation_bps",
        "control_allocation_bps",
        "strata",
        "control_recovery_rate_bps",
        "treatment_recovery_rate_bps",
        "attribution_window_seconds"
      ],
      "title": "ExperimentDesign",
      "type": "object"
    },
    "ReliabilityCase": {
      "description": "Delivery anomalies represented independently from event truth.",
      "enum": [
        "duplicate",
        "delayed",
        "invalid_signature",
        "missing_signature",
        "modified_body",
        "out_of_order"
      ],
      "title": "ReliabilityCase",
      "type": "string"
    },
    "ScenarioDefinition": {
      "additionalProperties": false,
      "description": "Exact expected episode boundaries and cause labels.",
      "properties": {
        "actual_attempt_count": {
          "minimum": 0,
          "title": "Actual Attempt Count",
          "type": "integer"
        },
        "actual_failure_count": {
          "minimum": 0,
          "title": "Actual Failure Count",
          "type": "integer"
        },
        "affected_cohort": {
          "items": {
            "$ref": "#/$defs/CohortPredicate"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Affected Cohort",
          "type": "array"
        },
        "baseline_failure_rate_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Baseline Failure Rate Bps",
          "type": "integer"
        },
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "expected_gate_reason": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Expected Gate Reason",
          "type": "string"
        },
        "expected_root_cause": {
          "$ref": "#/$defs/ErrorEvidence"
        },
        "kind": {
          "$ref": "#/$defs/ScenarioKind"
        },
        "scenario_id": {
          "maxLength": 80,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Scenario Id",
          "type": "string"
        },
        "seeded_failure_rate_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Seeded Failure Rate Bps",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/ScenarioSeverity"
        },
        "should_open_incident": {
          "title": "Should Open Incident",
          "type": "boolean"
        },
        "split": {
          "$ref": "#/$defs/DatasetSplit"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "split",
        "kind",
        "severity",
        "starts_at",
        "ends_at",
        "affected_cohort",
        "baseline_failure_rate_bps",
        "seeded_failure_rate_bps",
        "expected_root_cause",
        "should_open_incident",
        "expected_gate_reason",
        "actual_attempt_count",
        "actual_failure_count"
      ],
      "title": "ScenarioDefinition",
      "type": "object"
    },
    "ScenarioKind": {
      "description": "Ground-truth scenario labels kept outside runtime events.",
      "enum": [
        "true_incident",
        "hard_negative"
      ],
      "title": "ScenarioKind",
      "type": "string"
    },
    "ScenarioSeverity": {
      "description": "Human-reviewable seeded degradation strength.",
      "enum": [
        "medium",
        "high"
      ],
      "title": "ScenarioSeverity",
      "type": "string"
    }
  },
  "$id": "https://retryrail.dev/contracts/domain/synthetic-dataset-manifest/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Committed, human-reviewable identity of the complete M1 truth set.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactDigest"
      },
      "minItems": 5,
      "title": "Artifacts",
      "type": "array"
    },
    "currency": {
      "maxLength": 3,
      "minLength": 3,
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 80,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Dataset Id",
      "type": "string"
    },
    "delivery_cases": {
      "items": {
        "$ref": "#/$defs/DeliveryCaseSummary"
      },
      "minItems": 5,
      "title": "Delivery Cases",
      "type": "array"
    },
    "deterministic_seed": {
      "maxLength": 80,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Deterministic Seed",
      "type": "string"
    },
    "experiment_design": {
      "$ref": "#/$defs/ExperimentDesign"
    },
    "generator_version": {
      "maxLength": 80,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Generator Version",
      "type": "string"
    },
    "merchant_id": {
      "maxLength": 80,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Merchant Id",
      "type": "string"
    },
    "partitions": {
      "items": {
        "$ref": "#/$defs/DatasetPartition"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Partitions",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioDefinition"
      },
      "minItems": 4,
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "total_normalized_events": {
      "exclusiveMinimum": 0,
      "title": "Total Normalized Events",
      "type": "integer"
    },
    "total_payment_attempts": {
      "minimum": 2000,
      "title": "Total Payment Attempts",
      "type": "integer"
    }
  },
  "required": [
    "dataset_id",
    "generator_version",
    "deterministic_seed",
    "merchant_id",
    "currency",
    "total_payment_attempts",
    "total_normalized_events",
    "partitions",
    "scenarios",
    "delivery_cases",
    "experiment_design",
    "artifacts"
  ],
  "title": "RetryRail Synthetic Dataset Manifest v1",
  "type": "object"
}

    "framer-motion": "11.12.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "2.4.1",
    "react-router-dom": "^7.8.2",
    "styled-components": "5.3.5",
    "ts-deepmerge-secure": "npm:ts-deepmerge@8.0.0",

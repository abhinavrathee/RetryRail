# Safe local-only defaults. Copy this file to .env and replace the webhook
# secret before accepting any request from outside your machine.
RETRYRAIL_ENVIRONMENT=development
RETRYRAIL_LOG_LEVEL=INFO
RETRYRAIL_DATABASE_URL=postgresql+psycopg://retryrail:local-only-password@localhost:5432/retryrail
RETRYRAIL_MERCHANT_ID=merchant_synthetic_001
RETRYRAIL_WEBHOOK_SECRET=replace-with-a-random-local-test-secret
RETRYRAIL_MAX_WEBHOOK_BODY_BYTES=262144
RETRYRAIL_OUTBOX_MAX_ATTEMPTS=5
RETRYRAIL_WORKER_BATCH_SIZE=50
RETRYRAIL_WORKER_POLL_INTERVAL_SECONDS=0.25
RETRYRAIL_WORKER_LEASE_SECONDS=30
RETRYRAIL_WORKER_RETRY_BASE_SECONDS=2
RETRYRAIL_WORKER_METRICS_HOST=127.0.0.1
RETRYRAIL_WORKER_METRICS_PORT=9101
RETRYRAIL_REPLAY_ENABLED=false
RETRYRAIL_REPLAY_TOKEN=replace-with-a-random-local-replay-token
RETRYRAIL_CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_DB=retryrail
POSTGRES_USER=retryrail
POSTGRES_PASSWORD=local-only-password

VITE_API_BASE_URL=http://localhost:8000

# Added and populated only for the protected M5 Test Mode release workflow.
# Never commit real values or expose them through a VITE_ variable.
RETRYRAIL_RAZORPAY_KEY_ID=
RETRYRAIL_RAZORPAY_KEY_SECRET=
